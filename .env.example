# Angonaloy-আঙ্গনালয় storefront <-> Merchant Suite dashboard connection.
# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Catalog API base:  {VITE_MERCHANT_SUITE_URL}/api/public/v1/angonaloy
# Checkout API:      {MERCHANT_SUITE_URL}/api/public/v1/angonaloy/orders

# --- Client (Vite) -----------------------------------------------------------
# Anything VITE_-prefixed is compiled into the public JS bundle and is readable
# by anyone. Never put a secret here.
#
# Local dev: the Merchant Suite dev server (default port 5002).
# Vercel:    the Suite's public URL — or the ngrok tunnel while it runs locally,
#            since Vercel cannot reach localhost. Rebuild after changing this;
#            the value is baked in at build time.
VITE_MERCHANT_SUITE_URL=http://localhost:5002

# Visitor-tracker workspace ID only. Never use this for catalog URLs.
VITE_STOREFRONT_ID=3cd26e57-85ef-4970-94a4-cd99c0f1b554

# Public Turnstile site key. The secret stays only in Merchant-Suite.
VITE_TURNSTILE_SITE_KEY=

# --- Server ------------------------------------------------------------------
# Same URL as above. Used by the server-side checkout POST (api/orders.ts on
# Vercel, server/order-service.ts locally).
MERCHANT_SUITE_URL=http://localhost:5002
# Fixed checkout handle. Keep this aligned with the catalog's angonaloy handle.
STOREFRONT_HANDLE=angonaloy

# SECRET. Used only by authenticated abandoned-checkout capture. Must match the
# value stored in the Suite's app_settings under "<orgId>:custom_store_api_key".
CUSTOM_ORDERS_API_KEY=
